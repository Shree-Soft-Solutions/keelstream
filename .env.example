# =========================================================================
# KeelStream Local Development Environment Variables
# Copy this file to `.env` before running `scripts/dev-up.sh` or `scripts/dev-up.ps1`
# =========================================================================

# --- Project & Runtime ---
COMPOSE_PROJECT_NAME=keelstream
ENVIRONMENT=development
LOG_LEVEL=info

# --- PostgreSQL 16 Configuration ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=keelstream
POSTGRES_PASSWORD=keelstream_secret
POSTGRES_DB=db_keelstream_core
KEYCLOAK_DB_NAME=db_keycloak
FRAPPE_DB_NAME=db_frappe
N8N_DB_NAME=db_n8n
DATABASE_URL=postgresql://keelstream:keelstream_secret@localhost:5432/db_keelstream_core

# --- Redis 7 Configuration ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3-Compatible Object Storage) Configuration ---
S3_ENDPOINT=http://localhost:9000
S3_CONSOLE_URL=http://localhost:9001
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PORT=9000
S3_CONSOLE_PORT=9001
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_ASSETS=keelstream-assets
S3_BUCKET_EXPORTS=keelstream-exports
S3_BUCKET_DLQ=keelstream-dlq

# --- Keycloak 24+ IAM & OIDC Configuration ---
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=keelstream
KEYCLOAK_CLIENT_ID=keelstream-api
KEYCLOAK_CLIENT_SECRET=keelstream-client-secret-local-dev
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/keelstream

# --- KeelStream Frontend ---
FRONTEND_PORT=3000

# --- n8n Workflow Automation Configuration (Staged Service) ---
N8N_PORT=5678
N8N_ENCRYPTION_KEY=keelstream_n8n_secret_key_12345

# --- KeelStream Core API & Ingestion Engine ---
API_PORT=8000
INGESTION_BURST_BUFFER_SIZE=10000
INGESTION_RATE_LIMIT_RPS=500
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30
IDEMPOTENCY_TTL_SECONDS=86400
JWT_SECRET=keelstream_dev_jwt_secret_must_be_changed_in_production
